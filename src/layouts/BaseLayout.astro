---
import "../styles/global.css";
import { site, pick } from "../data/site";
import { getLangFromUrl } from "../i18n/utils";
import BackToTop from "../components/BackToTop.astro";

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const { title, description, path = "" } = Astro.props;
const lang = getLangFromUrl(Astro.url);

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${pick(site.title, lang)}`;
const pageDescription = description ?? pick(site.bio, lang);
const canonical = `https://tyronnemendoza.com${path}`;
const altPath = lang === "es" ? `/en${path}` : path.replace(/^\/en/, "") || "/";
const altUrl = `https://tyronnemendoza.com${altPath}`;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0b" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={`https://tyronnemendoza.com${lang === "es" ? path : path.replace(/^\/en/, "") || "/"}`} />
    <link rel="alternate" hreflang="en" href={`https://tyronnemendoza.com${lang === "en" ? path : `/en${path}`}`} />
    <link rel="alternate" hreflang="x-default" href={`https://tyronnemendoza.com${path.replace(/^\/en/, "") || "/"}`} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={site.fullName} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "es" ? "en_US" : "es_ES"} />
    <meta property="og:image" content="https://tyronnemendoza.com/og-image.svg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.fullName} — ${pick(site.title, lang)}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content="https://tyronnemendoza.com/og-image.svg" />
    <meta name="twitter:creator" content="@devfrikz" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen antialiased">
    <slot />
    <BackToTop />
  </body>
</html>
