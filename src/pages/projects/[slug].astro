---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Reveal from "../../components/Reveal.astro";
import CommandPalette from "../../components/CommandPalette.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: projects[(index - 1 + projects.length) % projects.length],
      next: projects[(index + 1) % projects.length],
    },
  }));
}

const { project, prev, next } = Astro.props;

const roleLabel: Record<string, string> = {
  fullstack: "Full Stack",
  devops: "SRE / DevOps",
  both: "Full Stack + DevOps",
};
---

<BaseLayout
  title={`${project.title} — Case study`}
  description={project.summary}
  path={`/projects/${project.slug}`}
>
  <Header />

  <main>
    <!-- ─── Hero del proyecto ─── -->
    <section class="relative overflow-hidden bg-dot-grid-fade border-b border-[color:var(--color-border)]">
      <div class="max-w-5xl mx-auto px-6 pt-24 pb-16 md:pt-32 md:pb-20">
        <a
          href="/#projects"
          class="inline-flex items-center gap-2 font-mono text-xs text-[color:var(--color-text-muted)] hover:text-[color:var(--color-accent)] transition-colors mb-8"
        >
          ← cd ../projects/
        </a>

        <p class="font-mono text-sm text-[color:var(--color-accent)] mb-4">
          $ cat projects/{project.slug}/README.md
        </p>

        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-4">
          {project.title}
        </h1>

        <p class="text-lg md:text-xl text-[color:var(--color-text-muted)] mb-8 max-w-3xl leading-relaxed">
          {project.summary}
        </p>

        <!-- Meta row -->
        <dl class="grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-4 py-6 border-y border-[color:var(--color-border)] max-w-3xl">
          {project.client && (
            <div>
              <dt class="font-mono text-[10px] uppercase tracking-wider text-[color:var(--color-text-subtle)] mb-1">
                Cliente
              </dt>
              <dd class="font-mono text-sm text-[color:var(--color-text)]">{project.client}</dd>
            </div>
          )}
          <div>
            <dt class="font-mono text-[10px] uppercase tracking-wider text-[color:var(--color-text-subtle)] mb-1">
              Rol
            </dt>
            <dd class="font-mono text-sm text-[color:var(--color-text)]">{project.jobTitle}</dd>
          </div>
          <div>
            <dt class="font-mono text-[10px] uppercase tracking-wider text-[color:var(--color-text-subtle)] mb-1">
              Periodo
            </dt>
            <dd class="font-mono text-sm text-[color:var(--color-text)]">{project.period}</dd>
          </div>
          {project.location && (
            <div>
              <dt class="font-mono text-[10px] uppercase tracking-wider text-[color:var(--color-text-subtle)] mb-1">
                Ubicación
              </dt>
              <dd class="font-mono text-sm text-[color:var(--color-text)]">{project.location}</dd>
            </div>
          )}
        </dl>

        <span class="inline-block mt-6 font-mono text-xs px-3 py-1 rounded-full border border-[color:var(--color-border-strong)] text-[color:var(--color-accent)]">
          {roleLabel[project.role]}
        </span>
      </div>
    </section>

    <!-- ─── Problema · Solución ─── -->
    <Reveal>
      <section class="max-w-5xl mx-auto px-6 py-20">
        <div class="grid md:grid-cols-2 gap-8">
          <article class="rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-8">
            <p class="font-mono text-xs text-[color:var(--color-accent)] mb-3 uppercase tracking-wider">
              # Problema
            </p>
            <p class="text-[color:var(--color-text-muted)] leading-relaxed">
              {project.problem}
            </p>
          </article>

          <article class="rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-8">
            <p class="font-mono text-xs text-[color:var(--color-accent)] mb-3 uppercase tracking-wider">
              # Solución
            </p>
            <p class="text-[color:var(--color-text-muted)] leading-relaxed">
              {project.solution}
            </p>
          </article>
        </div>
      </section>
    </Reveal>

    <!-- ─── Impacto ─── -->
    <Reveal>
      <section class="max-w-5xl mx-auto px-6 py-12">
        <p class="font-mono text-sm text-[color:var(--color-accent)] mb-6">
          $ tail -f impact.log
        </p>
        <h2 class="text-2xl md:text-3xl font-bold mb-8">Impacto medible</h2>

        <ul class="grid sm:grid-cols-2 gap-4">
          {project.impact.map((item) => (
            <li class="flex items-start gap-3 p-5 rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface)]/40">
              <span class="font-mono text-[color:var(--color-accent)] text-lg flex-shrink-0 leading-none mt-0.5">→</span>
              <span class="text-[color:var(--color-text)] leading-relaxed">{item}</span>
            </li>
          ))}
        </ul>
      </section>
    </Reveal>

    <!-- ─── Stack ─── -->
    <Reveal>
      <section class="max-w-5xl mx-auto px-6 py-12">
        <p class="font-mono text-sm text-[color:var(--color-accent)] mb-6">
          $ cat stack.txt
        </p>
        <h2 class="text-2xl md:text-3xl font-bold mb-8">Stack técnico</h2>

        <div class="flex flex-wrap gap-2">
          {project.stack.map((tech) => (
            <span class="font-mono text-sm px-3 py-1.5 rounded-md bg-[color:var(--color-surface)] border border-[color:var(--color-border)] text-[color:var(--color-text)]">
              {tech}
            </span>
          ))}
        </div>
      </section>
    </Reveal>

    <!-- ─── Links públicos ─── -->
    {project.links && project.links.length > 0 && (
      <Reveal>
        <section class="max-w-5xl mx-auto px-6 py-12">
          <p class="font-mono text-sm text-[color:var(--color-accent)] mb-6">
            $ curl -I project-urls
          </p>
          <h2 class="text-2xl md:text-3xl font-bold mb-8">Sitios públicos</h2>

          <div class="grid sm:grid-cols-2 gap-3">
            {project.links.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between gap-4 p-4 rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface)]/60 hover:border-[color:var(--color-accent)] transition-colors group"
              >
                <span class="font-mono text-sm text-[color:var(--color-text)] group-hover:text-[color:var(--color-accent)] transition-colors">
                  {link.label}
                </span>
                <span class="font-mono text-xs text-[color:var(--color-text-subtle)] group-hover:translate-x-1 transition-transform">
                  ↗
                </span>
              </a>
            ))}
          </div>
        </section>
      </Reveal>
    )}

    <!-- ─── Navegación prev/next ─── -->
    <Reveal>
      <section class="max-w-5xl mx-auto px-6 py-20 border-t border-[color:var(--color-border)] mt-12">
        <div class="grid sm:grid-cols-2 gap-4">
          <a
            href={`/projects/${prev.slug}`}
            class="group rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface)]/40 p-6 hover:border-[color:var(--color-accent)] transition-colors"
          >
            <p class="font-mono text-[10px] uppercase tracking-wider text-[color:var(--color-text-subtle)] mb-2">
              ← Anterior
            </p>
            <p class="text-base font-semibold text-[color:var(--color-text)] group-hover:text-[color:var(--color-accent)] transition-colors">
              {prev.title}
            </p>
            <p class="font-mono text-xs text-[color:var(--color-text-muted)] mt-1">
              {prev.jobTitle}
            </p>
          </a>

          <a
            href={`/projects/${next.slug}`}
            class="group rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface)]/40 p-6 hover:border-[color:var(--color-accent)] transition-colors sm:text-right"
          >
            <p class="font-mono text-[10px] uppercase tracking-wider text-[color:var(--color-text-subtle)] mb-2">
              Siguiente →
            </p>
            <p class="text-base font-semibold text-[color:var(--color-text)] group-hover:text-[color:var(--color-accent)] transition-colors">
              {next.title}
            </p>
            <p class="font-mono text-xs text-[color:var(--color-text-muted)] mt-1">
              {next.jobTitle}
            </p>
          </a>
        </div>
      </section>
    </Reveal>
  </main>

  <Footer />
  <CommandPalette />
</BaseLayout>
