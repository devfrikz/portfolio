---
import { projects } from "../data/projects";
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const roleLabel: Record<string, string> = {
  fullstack: t("role.fullstack"),
  devops: t("role.devops"),
  both: t("role.both"),
};

const featured = projects.filter((p) => p.featured);
---

<section id="projects" class="max-w-6xl mx-auto px-6 py-16">
  <p class="font-mono text-sm text-[color:var(--color-accent)] mb-6">
    $ ls -la projects/
  </p>

  <h2 class="text-3xl md:text-4xl font-bold mb-4">
    {t("projects.title")}
  </h2>
  <p class="text-[color:var(--color-text-muted)] text-lg max-w-3xl mb-12 leading-relaxed">
    {t("projects.intro")}
  </p>

  <div class="grid gap-6">
    {featured.map((project) => (
      <a
        href={getLocalizedPath(`/projects/${project.slug}`, lang)}
        class="block rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-8 hover:border-[color:var(--color-accent)] transition-colors group"
      >
        <div class="flex items-start justify-between gap-4 mb-3 flex-wrap">
          <div>
            <h3 class="text-xl font-semibold group-hover:text-[color:var(--color-accent)] transition-colors">
              {project.title}
            </h3>
            {project.client && (
              <p class="font-mono text-xs text-[color:var(--color-text-subtle)] mt-1">
                {project.client} · {project.period[lang]}
              </p>
            )}
          </div>
          <span class="font-mono text-xs px-3 py-1 rounded-full border border-[color:var(--color-border)] text-[color:var(--color-text-muted)] flex-shrink-0">
            {roleLabel[project.role]}
          </span>
        </div>

        <p class="text-[color:var(--color-text-muted)] mb-6 leading-relaxed">
          {project.summary[lang]}
        </p>

        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="flex flex-wrap gap-2">
            {project.stack.slice(0, 6).map((tech) => (
              <span class="font-mono text-xs px-2 py-1 rounded bg-[color:var(--color-bg)] text-[color:var(--color-text-muted)]">
                {tech}
              </span>
            ))}
            {project.stack.length > 6 && (
              <span class="font-mono text-xs px-2 py-1 text-[color:var(--color-text-subtle)]">
                +{project.stack.length - 6} {t("projects.more")}
              </span>
            )}
          </div>
          <span class="font-mono text-sm text-[color:var(--color-accent)] group-hover:translate-x-1 transition-transform">
            {t("projects.viewCase")}
          </span>
        </div>
      </a>
    ))}
  </div>
</section>
