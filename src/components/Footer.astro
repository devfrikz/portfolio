---
import { site } from "../data/site";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-[color:var(--color-border)] mt-12">
  <div class="max-w-5xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-[color:var(--color-text-muted)]">
    <p class="font-mono">
      © {year} {site.fullName}
    </p>
    <p class="font-mono text-xs">
      {t("footer.builtWith")}
    </p>
  </div>
</footer>
