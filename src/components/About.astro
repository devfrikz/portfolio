---
const fullstack = {
  title: "Full Stack Senior",
  description:
    "Diseño y construyo APIs y aplicaciones web de extremo a extremo, desde el modelo de datos hasta la UI.",
  stack: [
    "Java 17+ / Spring Boot 4",
    "TypeScript / React 19 / Vue 3",
    "PostgreSQL / MySQL / MongoDB / Redis",
    "Gradle / Vite / Bun",
    "REST · GraphQL · Server-Sent Events",
  ],
};

const devops = {
  title: "SRE / DevOps Senior",
  description:
    "Llevo plataformas a producción de forma confiable: contenedores, orquestación, observabilidad y automatización.",
  stack: [
    "Kubernetes (EKS, AKS)",
    "AWS · Azure",
    "Terraform · Helm · ArgoCD",
    "GitLab CI/CD · GitHub Actions",
    "Prometheus · Grafana · Metabase",
  ],
};
---

<section id="about" class="max-w-5xl mx-auto px-6 py-24">
  <p class="font-mono text-sm text-[color:var(--color-accent)] mb-6">
    $ cat about.md
  </p>
  <h2 class="text-3xl md:text-4xl font-bold mb-4">Dos perfiles, un mismo workflow</h2>
  <p class="text-[color:var(--color-text-muted)] text-lg max-w-2xl mb-12">
    Trabajo en el cruce entre desarrollo y operaciones. Construyo el sistema y lo opero — entiendo qué falla en producción porque también lo escribí.
  </p>

  <div class="grid md:grid-cols-2 gap-6">
    {[fullstack, devops].map((profile) => (
      <article class="rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-8 hover:border-[color:var(--color-accent)] transition-colors">
        <h3 class="text-xl font-semibold mb-3">{profile.title}</h3>
        <p class="text-[color:var(--color-text-muted)] mb-6">{profile.description}</p>
        <ul class="space-y-2">
          {profile.stack.map((item) => (
            <li class="font-mono text-sm text-[color:var(--color-text-muted)] flex items-start gap-2">
              <span class="text-[color:var(--color-accent)] mt-1">›</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>
