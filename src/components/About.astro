---
import { site, pick } from "../data/site";
import { tech } from "../data/tech";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const fullstackTechs = [
  tech.java, tech.spring, tech.nodejs,
  tech.typescript, tech.react, tech.vue,
  tech.postgresql, tech.mysql, tech.mongodb,
  tech.redis, tech.rabbitmq, tech.elasticsearch,
];

const devopsTechs = [
  tech.kubernetes, tech.docker, tech.aws,
  tech.azure, tech.terraform, tech.helm,
  tech.ansible, tech.gitlab, tech.github,
  tech.prometheus, tech.grafana, tech.linux,
];

const profiles = [
  { title: t("about.fullstackTitle"), description: t("about.fullstackDesc"), techs: fullstackTechs },
  { title: t("about.devopsTitle"), description: t("about.devopsDesc"), techs: devopsTechs },
];
---

<section id="about" class="max-w-6xl mx-auto px-6 py-16">
  <p class="font-mono text-sm text-[color:var(--color-accent)] mb-6">
    $ cat about.md
  </p>

  <h2 class="text-3xl md:text-4xl font-bold mb-4">
    {t("about.title")}
  </h2>
  <p class="text-[color:var(--color-text-muted)] text-lg max-w-3xl mb-10 leading-relaxed">
    {pick(site.about, lang)}
  </p>

  <ul class="grid sm:grid-cols-2 gap-3 mb-14 max-w-3xl">
    {pick(site.highlights, lang).map((item) => (
      <li class="flex items-start gap-3 text-sm text-[color:var(--color-text-muted)]">
        <span class="font-mono text-[color:var(--color-accent)] mt-0.5 flex-shrink-0">›</span>
        <span>{item}</span>
      </li>
    ))}
  </ul>

  <div class="grid md:grid-cols-2 gap-6">
    {profiles.map((profile) => (
      <article class="rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-8 hover:border-[color:var(--color-accent)] transition-colors">
        <h3 class="text-xl font-semibold mb-3">{profile.title}</h3>
        <p class="text-[color:var(--color-text-muted)] mb-6 leading-relaxed">
          {profile.description}
        </p>
        <ul class="grid grid-cols-3 sm:grid-cols-4 gap-3">
          {profile.techs.map((t) => (
            <li
              class="flex flex-col items-center justify-center gap-2 p-3 rounded-md bg-[color:var(--color-bg)]/60 border border-transparent hover:border-[color:var(--color-border-strong)] transition-colors group aspect-square"
              title={t.name}
            >
              <img
                src={t.icon}
                alt={t.name}
                loading="lazy"
                width="28"
                height="28"
                class="opacity-75 group-hover:opacity-100 transition-opacity"
              />
              <span class="font-mono text-[9px] text-[color:var(--color-text-subtle)] text-center leading-tight">
                {t.name}
              </span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>