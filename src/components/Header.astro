---
import { site } from "../data/site";

const navItems = [
  { label: "Sobre mí", href: "/#about" },
  { label: "Proyectos", href: "/#projects" },
  { label: "CV", href: "/cv" },
  { label: "Contacto", href: "/#contact" },
];
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-[color:var(--color-bg)]/80 border-b border-[color:var(--color-border)]">
  <nav class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
    <a
      href="/"
      class="font-mono text-sm font-semibold text-[color:var(--color-accent)] hover:text-[color:var(--color-accent-hover)] transition-colors"
    >
      ~/{site.name.toLowerCase().replace(" ", "")}
    </a>

    <ul class="hidden md:flex items-center gap-8 text-sm text-[color:var(--color-text-muted)]">
      {navItems.map((item) => (
        <li>
          <a href={item.href} class="hover:text-[color:var(--color-text)] transition-colors">
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <a
      href={site.social.email}
      class="text-sm px-4 py-2 rounded-md bg-[color:var(--color-accent)] text-[color:var(--color-bg)] font-medium hover:bg-[color:var(--color-accent-hover)] transition-colors"
    >
      Hablemos
    </a>
  </nav>
</header>